# Required to read Sentry issues. Use an event:read token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_REGION=us
SENTRY_READ_TOKEN=

# Optional AI enrichment. Leave blank for local summaries.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
AI_INCLUDE_STACK=false

# Optional for preview. Required for --apply.
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=
AZDO_WORK_ITEM_TYPE=Bug
AZDO_AREA_PATH=
AZDO_BACKLOG_ITERATION_PATH=

# Required only for --slack.
SLACK_WEBHOOK_URL=
